{
  // Konfiguration für Cloudflare Workers (statische Dateien + kleiner Worker für /api/*, kein Build-Schritt)
  // Name muss zum bereits bestehenden, mit GitHub verbundenen Worker-Projekt passen
  "name": "cuttingforce-app",
  "compatibility_date": "2026-10-14",
  // Worker-Script: läuft nur für Adressen, zu denen keine Datei unter public/ passt (siehe worker/index.js)
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    // Zugriff des Workers auf die statischen Dateien (für /versuchsprotokoll/ -> App-Datei)
    "binding": "ASSETS",
    // Diese Apps nur für angemeldete Benutzer: der Worker prüft zuerst die Anmeldung
    "run_worker_first": ["/spanbildung", "/spanbildung/*", "/vorspannrechner", "/vorspannrechner/*"]
  },
  // D1-Datenbank für Benutzerkonten/Sitzungen
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cuttingforce-db",
      "database_id": "98d2cc2b-7b99-4beb-bc47-8f774805dce4"
    }
  ]
}
